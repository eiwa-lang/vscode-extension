{
  "name": "Eiwa",
  "scopeName": "source.eiwa",
  "fileTypes": ["ei"],
  "patterns": [
    {"include": "#shebang"},
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#annotations"},
    {"include": "#declarations"},
    {"include": "#keywords"},
    {"include": "#literals"},
    {"include": "#supports"},
    {"include": "#operators"},
    {"include": "#calls"}
  ],
  "repository": {
    "shebang": {
      "name": "comment.line.shebang.eiwa",
      "match": "^#!.*$"
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.eiwa",
          "match": "//.*$"
        },
        {
          "name": "comment.block.eiwa",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{"include": "#comments"}]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.eiwa",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.eiwa",
              "match": "\\\\(u[0-9a-fA-F]{4}|[tbrn'\"\\\\$])"
            },
            {"include": "#interpolation"}
          ]
        },
        {
          "name": "string.quoted.single.eiwa",
          "match": "'(\\\\(u[0-9a-fA-F]{4}|[tbrn'\"\\\\])|[^'\\\\\\n\\r])'"
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "variable.interpolation.eiwa",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "variable.interpolation.eiwa",
          "begin": "\\$\\{",
          "end": "\\}",
          "patterns": [{"include": "$self"}]
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.eiwa",
          "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {"name": "punctuation.definition.annotation.eiwa"},
            "2": {"name": "variable.annotation.eiwa"}
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {"name": "keyword.declaration.eiwa"},
            "2": {"name": "entity.name.function.eiwa"}
          }
        },
        {
          "match": "\\b(type|contract|skill|enum|object|lib|class|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {"name": "keyword.declaration.eiwa"},
            "2": {"name": "entity.name.type.eiwa"}
          }
        },
        {
          "match": "\\b(val|var)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {"name": "keyword.declaration.eiwa"},
            "2": {"name": "variable.other.eiwa"}
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.eiwa",
          "match": "\\b(if|else|when|for|while|do|try|catch|finally|throw|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.eiwa",
          "match": "\\b(fun|val|var|type|contract|skill|enum|object|class|interface|lib|test|companion|import|from|typealias|init|constructor|package)\\b"
        },
        {
          "name": "keyword.modifier.eiwa",
          "match": "\\b(public|private|internal|protected|open|abstract|final|sealed|data|inner|value|annotation|expect|actual|override|implement|lateinit|operator|infix|inline|external|tailrec|suspend|const|vararg|noinline|crossinline|reified)\\b"
        },
        {
          "name": "keyword.operator.word.eiwa",
          "match": "\\b(is|in|as|of|by|where|get|set|out)\\b"
        },
        {
          "name": "variable.language.eiwa",
          "match": "\\b(this|super|it|field)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.eiwa",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "constant.numeric.hex.eiwa",
          "match": "\\b0[xX][0-9a-fA-F_]+[uUL]?\\b"
        },
        {
          "name": "constant.numeric.binary.eiwa",
          "match": "\\b0[bB][01_]+[uUL]?\\b"
        },
        {
          "name": "constant.numeric.float.eiwa",
          "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d[\\d_]*)[fF]?\\b|\\b\\d[\\d_]*\\.\\d[\\d_]*[fF]?\\b|\\b\\d[\\d_]*[fF]\\b"
        },
        {
          "name": "constant.numeric.integer.eiwa",
          "match": "\\b\\d[\\d_]*[uUL]?\\b"
        }
      ]
    },
    "supports": {
      "patterns": [
        {
          "name": "storage.type.eiwa",
          "match": "\\b(Int|Double|Float|Long|Short|Byte|UInt|ULong|Bool|Boolean|String|Char|Pointer|Void|List|Map|Set|MutableList|MutableMap|MutableSet|Array)\\b"
        },
        {
          "name": "constant.other.enum.eiwa",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        },
        {
          "name": "entity.name.type.eiwa",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.eiwa",
          "match": "\\?:|\\?\\.|!!|->|\\.\\.\\.|\\.\\.<|\\.\\.|==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|%=|[+\\-*/%=<>!?:|&]"
        },
        {
          "name": "punctuation.accessor.eiwa",
          "match": "::|\\."
        },
        {
          "name": "punctuation.separator.eiwa",
          "match": "[;,]"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.eiwa",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    }
  }
}
